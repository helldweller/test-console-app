<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>TestConsole</AssemblyName>
    <RootNamespace>TestConsole</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="Code quality">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Pinned so a newer SDK cannot break the build with new rules. -->
    <AnalysisLevel>8.0-recommended</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup Label="Assembly info">
    <Product>TestConsole</Product>
    <Description>Launches the newest TestApp.exe version found under C:\Prog\.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
